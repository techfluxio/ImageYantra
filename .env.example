# ── Supabase (admin backend: auth, content, analytics, glitch reports) ──
# From your Supabase project → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to expose to the
# browser (Row Level Security enforces what it can actually read/write).
# Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL of the processing backend (see /processing-backend folder) — compress-pdf, remove-bg
VITE_PROCESSING_API_BASE_URL=http://localhost:4100/api

# ─────────────────────────────────────────────────────────────────────
# The following are NOT VITE_ variables — they're never read by the
# frontend build. They're Supabase Edge Function secrets (set via
# `supabase secrets set` or the Dashboard), needed only by
# supabase/functions/upload-tool and deploy-webhook. Listed here for
# reference; see SETUP.md for exact setup steps.
#
#   GITHUB_TOKEN=github_pat_...            (fine-grained PAT, Contents: read/write, this repo only)
#   GITHUB_REPO=your-username/imageyantra-frontend
#   GITHUB_BRANCH=main
#   VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...
#   DEPLOY_WEBHOOK_SECRET=some-random-string   (optional, for deploy-webhook)
